<Window x:Class="QuickReply.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="420"
    Height="40"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        PreviewMouseLeftButtonDown="Header_OnMouseLeftButtonDown"
        PreviewMouseWheel="MainWindow_OnPreviewMouseWheel">
    <Border x:Name="HeaderBorder" CornerRadius="20" Background="#333333" Padding="10,4">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Width="26"
                    Height="26"
                    Margin="0,0,8,0"
                    FontSize="16"
                    Content="+"
                    Background="Transparent"
                    Foreground="White"
                    BorderBrush="Transparent"
                    Click="AddButton_OnClick" />

            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       Foreground="White"
                       Margin="0,0,8,0"
                       Text="Quik-R"
                       FontSize="14" />

                <TextBox x:Name="SearchTextBox"
                     Grid.Column="2"
                     Width="180"
                     Height="24"
                     Margin="0,0,8,0"
                     VerticalContentAlignment="Center"
                     FontSize="12"
                     Padding="8,0"
                     Background="#4A4A4A"
                     Foreground="White"
                     BorderBrush="#666666"
                     CaretBrush="White"
                     TextChanged="SearchTextBox_OnTextChanged"
                     ToolTip="Search by name or message" />

            <Button x:Name="AimButton"
                    Grid.Column="3"
                    Width="26"
                    Height="26"
                    Margin="0,0,6,0"
                    FontSize="13"
                    Content="◎"
                    Background="Transparent"
                    Foreground="White"
                    BorderBrush="Transparent"
                    Click="AimButton_OnClick" />

                    <Button Grid.Column="4"
                    Width="26"
                    Height="26"
                    Margin="0,0,6,0"
                    FontSize="13"
                    Content="—"
                    Background="Transparent"
                    Foreground="White"
                    BorderBrush="Transparent"
                    Click="CollapseButton_OnClick" />

                    <Button Grid.Column="5"
                    Width="26"
                    Height="26"
                    FontSize="13"
                    Content="✕"
                    Background="Transparent"
                    Foreground="White"
                    BorderBrush="Transparent"
                    Click="CloseButton_OnClick" />
        </Grid>
    </Border>
</Window>
