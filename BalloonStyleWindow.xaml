<Window x:Class="QuickReply.BalloonStyleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="320"
        Height="220"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Title="Balloon Style"
        ShowInTaskbar="False"
        Topmost="True">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Color" FontWeight="SemiBold" />
        <ComboBox x:Name="ColorCombo"
                  Grid.Row="1"
                  Margin="0,6,0,0"
                  SelectedIndex="0">
            <ComboBoxItem Content="White" Tag="#FFFFFF" />
            <ComboBoxItem Content="Light Yellow" Tag="#FFF9C4" />
            <ComboBoxItem Content="Light Green" Tag="#C8E6C9" />
            <ComboBoxItem Content="Light Blue" Tag="#BBDEFB" />
            <ComboBoxItem Content="Light Pink" Tag="#F8BBD0" />
            <ComboBoxItem Content="Light Purple" Tag="#E1BEE7" />
            <ComboBoxItem Content="Gray" Tag="#EEEEEE" />
        </ComboBox>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="Opacity" FontWeight="SemiBold" />
            <Slider x:Name="OpacitySlider"
                    Margin="0,6,0,0"
                    Minimum="0.25"
                    Maximum="1.0"
                    TickFrequency="0.05"
                    IsSnapToTickEnabled="True" />
            <Border x:Name="PreviewBorder" Margin="0,10,0,0" Height="40" CornerRadius="10" BorderThickness="1" BorderBrush="#808080">
                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Text="Preview" />
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Width="80" Margin="0,0,8,0" Content="Cancel" IsCancel="True" />
            <Button Width="80" Content="Save" IsDefault="True" Click="SaveButton_OnClick" />
        </StackPanel>
    </Grid>
</Window>
