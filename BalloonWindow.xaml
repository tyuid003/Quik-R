<Window x:Class="QuickReply.BalloonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420"
    Height="40"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        Topmost="True"
        ShowInTaskbar="False"
        PreviewMouseWheel="Window_OnPreviewMouseWheel">
    <Border x:Name="RootBorder" CornerRadius="20" Background="#CCFFFFFF" Padding="8,3">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="DragButton"
                    Grid.Column="0"
                    Width="22"
                    Height="22"
                    Margin="0,0,6,0"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="12"
                    Content="☰"
                    PreviewMouseLeftButtonDown="DragButton_OnMouseDown" />

            <Button x:Name="MessageButton"
                    Grid.Column="1"
                    Margin="2,0,6,0"
                    BorderThickness="0"
                    Background="Transparent"
                    HorizontalContentAlignment="Left"
                    VerticalContentAlignment="Center"
                    FontSize="13"
                    Click="MessageButton_OnClick" />

            <Button x:Name="SendButton"
                    Grid.Column="2"
                    Width="22"
                    Height="22"
                    Margin="0,0,6,0"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="12"
                    Content="➤"
                    Click="SendButton_OnClick" />

                    <Button x:Name="EditButton"
                        Grid.Column="3"
                        Width="22"
                        Height="22"
                        Margin="0,0,6,0"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="12"
                    Content="✎"
                    Click="EditButton_OnClick" />

                    <Button x:Name="DeleteButton"
                        Grid.Column="4"
                        Width="22"
                        Height="22"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="12"
                        Content="x"
                        Click="DeleteButton_OnClick" />
        </Grid>
    </Border>
</Window>
